+def request_headers(url):
+    headers = {"User-Agent": "strata-mtp-fetch"}
+    token_file = os.environ.get("STRATA_HF_TOKEN_FILE")
+    if token_file and urlsplit(url).hostname == "huggingface.co":
+        headers["Authorization"] = "Bearer " + Path(token_file).read_text().strip()
+    return headers
+
+
+class SafeRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        redirected = super().redirect_request(req, fp, code, msg, headers, newurl)
+        if redirected is not None and (urlsplit(req.full_url).hostname != urlsplit(newurl).hostname or urlsplit(newurl).scheme != "https"):
+            redirected.remove_header("Authorization")
+        return redirected
+
+
+OPENER = urllib.request.build_opener(SafeRedirect)

